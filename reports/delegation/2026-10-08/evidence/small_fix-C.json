  "synthetic_outputs": {
    "budget.py": "\"\"\"Deterministic proportional budget allocation.\"\"\"\n\nfrom decimal import Decimal\nfrom fractions import Fraction\nfrom math import isfinite\n\n\ndef split_budget(total: float, weights: list[float]) -> list[float]:\n    if not isfinite(total) or total < 0:\n        raise ValueError(\"total must be finite and non-negative\")\n    if not weights or any(not isfinite(weight) or weight <= 0 for weight in weights):\n        raise ValueError(\"weights must be finite and positive\")\n\n    # Use cents, or the total's finer decimal precision when necessary.\n    scale = 10 ** max(2, -Decimal(str(total)).as_tuple().exponent)\n    units = int(Fraction(str(total)) * scale)\n    exact_weights = [Fraction(str(weight)) for weight in weights]\n    weight_sum = sum(exact_weights)\n    quotas = [units * weight / weight_sum for weight in exact_weights]\n    allocated = [quota.numerator // quota.denominator for quota in quotas]\n\n    # Stable sorting gives equal remainders to earlier input positions.\n    priority = sorted(\n        range(len(weights)), key=lambda i: quotas[i] - allocated[i], reverse=True\n    )\n    for i in priority[:units - sum(allocated)]:\n        allocated[i] += 1\n    return [float(Fraction(amount, scale)) for amount in allocated]\n"
