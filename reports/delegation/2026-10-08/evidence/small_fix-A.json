  "synthetic_outputs": {
    "budget.py": "\"\"\"Allocate budgets using the largest-remainder method.\"\"\"\n\nfrom fractions import Fraction\n\n\ndef split_budget(total: float, weights: list[float]) -> list[float]:\n    \"\"\"Distribute cents in proportion to weights, breaking ties by input order.\"\"\"\n    total = Fraction(str(total))\n    if total < 0:\n        raise ValueError(\"total must be non-negative\")\n    weights = [Fraction(str(weight)) for weight in weights]\n    if not weights or any(weight <= 0 for weight in weights):\n        raise ValueError(\"weights must be positive\")\n    weight_sum = sum(weights)\n    shares = [total * 100 * weight / weight_sum for weight in weights]\n    cents = [share.numerator // share.denominator for share in shares]\n    order = sorted(range(len(weights)), key=lambda i: shares[i] - cents[i],\n                   reverse=True)\n    remaining = total * 100 - sum(cents)\n    whole_cents = remaining.numerator // remaining.denominator\n    for index in order[:whole_cents]:\n        cents[index] += 1\n\n    amounts = [Fraction(value, 100) for value in cents]\n    # Preserve any fractional cent in a total rather than rounding it away.\n    if remaining > whole_cents:\n        amounts[order[whole_cents]] += (remaining - whole_cents) / 100\n    return [float(amount) for amount in amounts]\n"
  },
