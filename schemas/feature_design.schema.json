{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow-playbook.local/schemas/feature_design.schema.json",
  "title": "AI Workflow Playbook Feature Design Registry",
  "type": "object",
  "required": [
    "schema_version",
    "feature_id",
    "status",
    "planning_depth",
    "risk_level",
    "brief_ref",
    "architecture_refs",
    "approval_policy",
    "slices"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "playbook.feature_design.v1"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_required",
        "approved",
        "superseded",
        "rejected",
        "implemented"
      ]
    },
    "planning_depth": {
      "type": "string",
      "enum": [
        "oneshot",
        "compact_design",
        "designed_slices"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "brief_ref": {
      "type": "string",
      "minLength": 1
    },
    "architecture_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "approval_policy": {
      "type": "string",
      "enum": [
        "human_required",
        "human_or_authorized_reviewer",
        "not_required"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "approval_notes": {
      "type": "string"
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slice_id",
          "status",
          "user_visible_outcome",
          "scope",
          "allowed_files",
          "forbidden_files",
          "expected_interfaces",
          "verification",
          "review_checkpoint",
          "dependencies",
          "change_budget",
          "rollback"
        ],
        "additionalProperties": false,
        "properties": {
          "slice_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "in_progress",
              "implemented",
              "reviewed",
              "blocked",
              "superseded"
            ]
          },
          "user_visible_outcome": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "allowed_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_interfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "change_budget": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
