{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow-playbook.local/schemas/feature_design.schema.json",
  "title": "AI Workflow Playbook Feature Design Registry",
  "type": "object",
  "required": [
    "schema_version",
    "feature_id",
    "status",
    "planning_depth",
    "risk_level",
    "brief_ref",
    "architecture_refs",
    "approval_policy",
    "slices"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "playbook.feature_design.v1"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_required",
        "approved",
        "superseded",
        "rejected",
        "implemented"
      ]
    },
    "planning_depth": {
      "type": "string",
      "enum": [
        "oneshot",
        "compact_design",
        "designed_slices"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "brief_ref": {
      "type": "string",
      "minLength": 1
    },
    "architecture_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "approval_policy": {
      "type": "string",
      "enum": [
        "human_required",
        "human_or_authorized_reviewer",
        "not_required"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "approval_method": {
      "type": "string",
      "enum": [
        "interactive_tty",
        "test_harness"
      ]
    },
    "approval_notes": {
      "type": "string"
    },
    "advisory_acknowledgement": {
      "type": "string"
    },
    "approved_markdown_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_registry_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_review_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "sha256",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "product_design_review",
              "program_design_review",
              "slice_review",
              "maintainability_review"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "ADVISORY"
            ]
          },
          "marker": {
            "type": "string",
            "minLength": 1
          },
          "record_path": {
            "type": "string",
            "minLength": 1
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reviewed_markdown_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reviewed_registry_payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "default": []
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slice_id",
          "status",
          "user_visible_outcome",
          "scope",
          "allowed_files",
          "forbidden_files",
          "expected_interfaces",
          "verification",
          "review_checkpoint",
          "dependencies",
          "change_budget",
          "rollback"
        ],
        "additionalProperties": false,
        "properties": {
          "slice_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "in_progress",
              "verification_failed",
              "review_required",
              "review_passed",
              "awaiting_human_acceptance",
              "accepted",
              "implemented",
              "reviewed",
              "blocked",
              "superseded"
            ]
          },
          "user_visible_outcome": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "allowed_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_interfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "argv"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "argv": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "cwd": {
                      "type": "string",
                      "default": "."
                    },
                    "required": {
                      "type": "boolean",
                      "default": true
                    },
                    "expected_exit_code": {
                      "type": "integer",
                      "default": 0
                    },
                    "timeout_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "default": 600
                    }
                  }
                }
              ]
            }
          },
          "review_checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "change_budget": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
