{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow-playbook.local/schemas/audited_executor_report.schema.json",
  "title": "Audited Executor Report",
  "type": "object",
  "required": ["schema_version", "run_id", "round", "trust_status"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "playbook.audited_executor_report.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1},
    "trust_status": {"const": "unverified"},
    "claims": {"type": "array"},
    "receipt_refs": {"type": "array"}
  }
}
