{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow-playbook.local/schemas/changeability_suite.schema.json",
  "title": "AI Workflow Playbook Changeability Suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "version", "evaluation_mode", "sequences"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "playbook.changeability_suite.v1" },
    "suite_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "evaluation_mode": { "type": "string", "enum": ["mechanism_demonstration", "empirical"] },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence_id", "title", "tasks"],
        "additionalProperties": false,
        "properties": {
          "sequence_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "tasks": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "task_id",
                "description",
                "success",
                "diff_lines",
                "files_touched",
                "new_test_failures",
                "required_refactor_before_change",
                "tool_calls",
                "tokens",
                "latency_ms",
                "policy_violations",
                "architecture_violations"
              ],
              "additionalProperties": false,
              "properties": {
                "task_id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "success": { "type": "boolean" },
                "diff_lines": { "type": "integer", "minimum": 0 },
                "files_touched": { "type": "integer", "minimum": 0 },
                "new_test_failures": { "type": "integer", "minimum": 0 },
                "required_refactor_before_change": { "type": "boolean" },
                "tool_calls": { "type": "integer", "minimum": 0 },
                "tokens": { "type": "integer", "minimum": 0 },
                "latency_ms": { "type": "integer", "minimum": 0 },
                "policy_violations": { "type": "array", "items": { "type": "string" } },
                "architecture_violations": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
