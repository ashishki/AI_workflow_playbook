{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow-playbook.local/schemas/audited_state.schema.json",
  "title": "Audited State",
  "type": "object",
  "required": ["schema_version", "run_id", "original_goal_ref", "requirements", "facts", "blockers", "open_requirements", "audit_refs", "round_counters", "budgets", "status"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "playbook.audited_state.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "original_goal_ref": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence_refs"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "verified", "blocked"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "facts": {"type": "array"},
    "blockers": {"type": "array"},
    "open_requirements": {"type": "array", "items": {"type": "string"}},
    "audit_refs": {"type": "array", "items": {"type": "string"}},
    "round_counters": {"type": "object"},
    "budgets": {"type": "object"},
    "status": {"enum": ["active", "stopped", "complete"]}
  }
}
